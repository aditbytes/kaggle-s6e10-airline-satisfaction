        <mxCell id="box26" value="&lt;b&gt;StratifiedKFold&lt;/b&gt; (src/cv.py)&lt;br&gt;5 folds · shuffle · seed 42&lt;br&gt;same folds for every experiment&lt;br&gt;139,927 rows per fold&lt;br&gt;44.36% satisfied in every fold" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane25">
